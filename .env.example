# Copy this file to .env for local development and fill in values as needed.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=true
SEED_DEMO=true
# Optional. Without this key, AI search uses keyword fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional production database URL, e.g. postgresql+psycopg://...
DATABASE_URL=
